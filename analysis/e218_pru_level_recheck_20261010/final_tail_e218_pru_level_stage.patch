+def pru_level_shift(train, rank, pred, pru25, pru26, protected, k=PRU_K, xs_max=PRU_XS_MAX):
+    """E218: per airport x month, gap = mean(pred - ref) over the PRU population P minus PRU's published additional time; on cells
+    without de-icing (PRU excluded share < xs_max above the airport's April-October 2025 level) every P row moves by
+    c = -k (gap - emu_hat), emu_hat = the airport's 2025 label-indicator minus published value over its months without de-icing.
+    Rows outside P, cells with de-icing and protected rows are unchanged."""
