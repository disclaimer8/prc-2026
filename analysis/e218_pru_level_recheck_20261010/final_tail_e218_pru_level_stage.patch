+def pru_read(root, year):
+    path, digest = PRU_CSV[year]
+    if sha(Path(root) / path) != digest:
+        raise ValueError('PRU file changed: ' + path)
+    p = pl.read_csv(Path(root) / path, schema_overrides={'MONTH_NUM': pl.Int32, 'COMMENT': pl.Utf8}).filter(pl.col('APT_ICAO').is_in(PRU_AIRPORTS))
