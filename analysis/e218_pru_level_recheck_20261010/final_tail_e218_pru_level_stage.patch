+def pru_level_stage(work, index, stage):
+    """Post-mixture E218 stage (default off): src version -> out version; reads the 2025 training labels and the ranking of the
+    workspace, the two SHA-pinned PRU files from the repository, and never moves a protected E156 row."""
+    work = Path(work)
+    root = Path(__file__).resolve().parents[1]
+    cols = [ID, 'PHASE_mvt', 'ADEP_mvt', 'MVT_TIME_UTC_mvt', 'STAND_mvt', 'RUNWAY_mvt', 'AIRCRAFT_TYPE_mvt']
+    def dep(path, label):
+        f = pl.read_parquet(path, columns=cols + ([Y] if label else [])).filter(pl.col('PHASE_mvt') == 'DEP')
+        f = f.with_columns(month=pl.col('MVT_TIME_UTC_mvt').dt.month().cast(pl.Int32)).drop('PHASE_mvt', 'MVT_TIME_UTC_mvt')
+        return f.rename({Y: 'y'}).with_columns(pl.col('y').cast(pl.Float64)) if label else f
+    train = pl.concat([dep(p, True) for p in sorted((work / 'data/prc-2026-datasets').glob('training_*.parquet'))])
+    src = read_sub(sub(work, stage['src']))
+    rank = dep(work / 'data/prc-2026-datasets/ranking.parquet', False).with_columns(pl.col(ID).cast(src.schema[ID]))
+    served = read(work / 'e156/run_0/served.json')
+    out, cells = pru_level_shift(train, rank, src, pru_read(root, 2025), pru_read(root, 2026),
+                                 np.array(served['ids'], dtype=np.float64),
+                                 k=stage['k'], xs_max=stage['xs_max'])
+    out.write_parquet(sub(work, stage['out']))
+    changed = int((out.sort(ID)[Y].cast(pl.Float64).to_numpy() != src.sort(ID)[Y].cast(pl.Float64).to_numpy()).sum())
+    return dict(rows_changed=changed, cells=cells.select(PRU_KEY + ['ind', 'pru_add_s', 'xs', 'emu_hat', 'eligible', 'c']).to_dicts(),
+                pru_sha256={str(y): v[1] for y, v in PRU_CSV.items()})
