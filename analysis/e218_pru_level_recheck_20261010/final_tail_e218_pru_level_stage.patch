+def pru_reference(train):
+    """P10 of the 2025 label per airport x stand x runway over all records passing PRU's filters; valid with >= 10 at or below
+    (same arithmetic as regime_quality_report.weighted_quantile_by_group with unit weights)."""
+    d = train.filter(pru_ok('y')).with_columns(w=pl.lit(1.0)).sort(PRU_GRP + ['y'])
+    d = d.with_columns(cw=pl.col('w').cum_sum().over(PRU_GRP), W=pl.col('w').sum().over(PRU_GRP))
+    q = d.filter(pl.col('cw') >= PRU_PCT * pl.col('W')).group_by(PRU_GRP).agg(pl.col('y').first().alias('ref'))
+    below = d.join(q, on=PRU_GRP, how='left').filter(pl.col('y') <= pl.col('ref')).group_by(PRU_GRP).agg(pl.col('w').sum().alias('n_le'))
+    return q.join(below, on=PRU_GRP, how='left').with_columns(valid=pl.col('n_le') >= PRU_MIN_LE).select(PRU_GRP + ['ref', 'valid'])
+
