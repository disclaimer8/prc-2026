+                    pru_add_s=pl.col('TOTAL_ADD_TIME_MIN') * 60 / pl.col('TOTAL_REF_NB_FL'), excl=1 - pl.col('VALID_FL') / pl.col('TF'))
+
+
+def pru_ok(col):
+    heli = pl.col('AIRCRAFT_TYPE_mvt').is_in(PRU_HELI)
+    return (pl.col('STAND_mvt').is_not_null() & pl.col('RUNWAY_mvt').is_not_null() & ~heli & (pl.col(col) >= 0) & (pl.col(col) <= PRU_MAX_TAXI)).fill_null(False)
