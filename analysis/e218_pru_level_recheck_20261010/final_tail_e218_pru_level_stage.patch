+    base = pru25.filter(pl.col('month').is_between(4, 10)).group_by('ADEP_mvt').agg(excl_base=pl.col('excl').mean())
+    p25, p26 = (p.join(base, on='ADEP_mvt').with_columns(xs=(pl.col('excl') - pl.col('excl_base')).clip(0, None)) for p in (pru25, pru26))
 
+    def indicator(df, col):
+        x = df.join(ref, on=PRU_GRP, how='left').filter(pru_ok(col) & pl.col('valid').fill_null(False))
+        return x.group_by(PRU_KEY).agg(ind=(pl.col(col) - pl.col('ref')).mean(), n_p=pl.len())
+    emu = indicator(train, 'y').join(p25, on=PRU_KEY, how='inner').filter(pl.col('xs') < xs_max).group_by('ADEP_mvt').agg(
